NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Painel de administração (/dashboard/admin) — NUNCA prefixar com NEXT_PUBLIC_,
# essas duas variáveis só podem existir no servidor.
# service_role key: Supabase → Project Settings → API → Project API keys →
# "service_role" (secret). Ela ignora todas as regras de RLS — trate como senha.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta
ADMIN_EMAIL=seu-email-de-admin@exemplo.com

# Protege /api/health, o endpoint que o Vercel Cron chama 1x por dia para
# manter o projeto Supabase Free ativo (ver vercel.json). A rota roda com a
# service_role key, então sem este segredo ela seria um endpoint público com
# acesso total ao banco. Gere um valor aleatório longo (ex: `openssl rand -hex 32`)
# e cadastre o mesmo valor na Vercel (Settings → Environment Variables).
CRON_SECRET=um-segredo-aleatorio-longo
